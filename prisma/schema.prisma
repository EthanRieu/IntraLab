generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model articles {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String         @db.VarChar(255)
  content          String
  category         String?        @db.VarChar(100)
  images           Json?
  status           String?        @default("draft") @db.VarChar(20)
  rejection_reason String?
  active           Boolean?       @default(true)
  deleted          Boolean?       @default(false)
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @db.Timestamptz(6)
  published_at     DateTime?      @db.Timestamptz(6)
  user_article     user_article[]

  @@index([category], map: "idx_articles_category")
  @@index([published_at], map: "idx_articles_published")
  @@index([status], map: "idx_articles_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model classes {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug               String    @unique @db.VarChar(10)
  name               String    @db.VarChar(255)
  level              Int
  has_specialization Boolean?  @default(false)
  active             Boolean?  @default(true)
  deleted            Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  users              users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model inventory {
  item_id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  item_name          String    @db.VarChar(255)
  item_description   String?
  category           String?   @db.VarChar(100)
  quantity           Int       @default(0)
  quantity_available Int       @default(0)
  location           String?   @db.VarChar(100)
  image_url          String?   @db.VarChar(500)
  active             Boolean?  @default(true)
  deleted            Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  loan               loan[]

  @@index([active, deleted], map: "idx_inventory_active")
  @@index([category], map: "idx_inventory_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model loan {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  borrower_id        String      @db.Uuid
  item_id            String      @db.Uuid
  quantity_requested Int         @default(1)
  quantity_approved  Int?        @default(0)
  status             String?     @default("pending") @db.VarChar(20)
  active             Boolean?    @default(true)
  deleted            Boolean?    @default(false)
  created_at         DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?   @default(now()) @db.Timestamptz(6)
  users              users       @relation(fields: [borrower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory          inventory   @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
  user_loan          user_loan[]

  @@index([borrower_id], map: "idx_loan_borrower")
  @@index([created_at], map: "idx_loan_dates")
  @@index([status], map: "idx_loan_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model notifications {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  type         String    @db.VarChar(50)
  title        String    @db.VarChar(255)
  message      String?
  related_id   String?   @db.Uuid
  related_type String?   @db.VarChar(50)
  read         Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  read_at      DateTime? @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([read], map: "idx_notifications_read")
  @@index([type], map: "idx_notifications_type")
  @@index([user_id], map: "idx_notifications_user")
}

model roles {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug       String    @unique @db.VarChar(64)
  name       String    @db.VarChar(255)
  active     Boolean?  @default(true)
  deleted    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model spec {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug       String    @unique @db.VarChar(64)
  name       String    @db.VarChar(255)
  active     Boolean?  @default(true)
  deleted    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users[]
