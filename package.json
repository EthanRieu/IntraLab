{
  "name": "intralab",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "dotenv -e .env.development -- nuxt dev",
    "generate": "nuxt generate",
    "preview": "dotenv -e .env.production -- nuxt preview",
    "postinstall": "nuxt prepare",
    "prisma:dev:generate": "dotenv -e .env.development -- prisma generate",
    "prisma:dev:migrate": "dotenv -e .env.development -- prisma migrate dev --name init",
    "prisma:prod:deploy": "dotenv -e .env.production -- prisma migrate deploy"
  },
  "dependencies": {
    "@inspira-ui/plugins": "^0.0.2",
    "@prisma/client": "^6.16.2",
"@tailwindcss/vite": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-average-color": "^9.5.0",
    "jsonwebtoken": "^9.0.2",
    "liquid-glass-vue": "^0.0.1",
    "lucide-vue-next": "^0.577.0",
    "nuxt": "^4.1.2",
    "ogl": "^1.0.11",
    "prisma": "^6.16.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "browserify-zlib": "^0.2.0",
    "dotenv-cli": "^7.4.4"
  }
}
